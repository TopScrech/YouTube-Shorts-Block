  "strings" : {
    "Bug reports, feature requests & contributions are always welcome!" : {
      "comment" : "A footer for the settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرحّب دائمًا بتقارير الأخطاء وطلبات الميزات والمساهمات!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejlrapporter, funktionsønsker og bidrag er altid velkomne!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlermeldungen, Funktionswünsche und Beiträge sind jederzeit willkommen!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements de bugs, les suggestions de fonctionnalités et les contributions sont toujours les bienvenus !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बग रिपोर्ट, नई सुविधाओं के सुझाव और योगदान का हमेशा स्वागत है!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le segnalazioni di bug, le richieste di funzionalità e i contributi sono sempre benvenuti!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugmeldingen, functieverzoeken en bijdragen zijn altijd welkom!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы всегда рады сообщениям об ошибках, предложениям новых функций и любому вкладу!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata bildirimleri, özellik istekleri ve katkılar her zaman memnuniyetle karşılanır!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми завжди раді повідомленням про помилки, запитам на нові функції та внескам у проєкт!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎提交错误报告、功能建议和贡献！"
